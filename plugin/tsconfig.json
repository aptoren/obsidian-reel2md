{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {"*": ["node_modules/*"]},
    "typeRoots": ["node_modules/@types", "node_modules"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "lib": ["dom", "es2022"]
  },
  "include": ["src/**/*.ts"]
}
